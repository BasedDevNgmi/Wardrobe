TRADOVATE_SEC=your-client-secret
TRADOVATE_DEVICE_ID=a-unique-uuid-for-this-server

# Accounts (JSON array)
TRADOVATE_ACCOUNTS='[
  {"name": "apex-account-1", "username": "user1", "password": "pass1", "env": "demo", "enabled": true, "qty_multiplier": 1.0},
  {"name": "apex-account-2", "username": "user2", "password": "pass2", "env": "demo", "enabled": true, "qty_multiplier": 1.0}
]'

# Symbol mapping (front-month contracts)
SYMBOL_MAP='{"MES": "MESU5", "MNQ": "MNQU5", "ES": "ESU5", "NQ": "NQU5"}'

# Risk defaults
DEFAULT_MAX_DAILY_LOSS=500
DEFAULT_MAX_POSITION_SIZE=5

# Notifications (phase 3)
DISCORD_WEBHOOK_URL=
